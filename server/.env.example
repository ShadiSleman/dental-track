# server/.env.example — same vars as root .env.example
# server/src/server.js loads the ROOT .env file automatically

APP_ENV=local
JWT_SECRET=change_me

DATABASE_URL=postgresql://USER:PASS@HOST/dental_track_local?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASS@HOST/dental_track_local?sslmode=require

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dental-track
R2_PUBLIC_URL=https://pub-XXXXXXXX.r2.dev

PORT=5051
FRONTEND_URL=http://localhost:5174
